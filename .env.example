# Copy to .env (the .env file is ignored by git; scripts/dev-up.sh does this itself).
# The silo-server instance variables for dev are set in docker-compose.dev.yml.

# Host ports for docker-compose.dev.yml (change them when the defaults are taken).
SILO_DEV_PG_PORT=5432
SILO_DEV_SERVER_PORT=8080
SILO_DEV_WEB_PORT=5173
SILO_DEV_IMAP_PORT=1143
SILO_DEV_SMTP_PORT=2525
SILO_DEV_SUBMISSION_PORT=1587

# IMAP sync engine and write-back (silo-server); docker-compose.dev.yml
# passes them to the silo-server container. Values = defaults.
SILO_SYNC_MAX_CONNECTIONS_PER_ACCOUNT=3
SILO_SYNC_INITIAL_CONCURRENCY=2
SILO_SYNC_POLL_INTERVAL=5m
SILO_SYNC_BACKFILL_RATE=5MB/s
SILO_MIRROR_MAX_MESSAGE_BYTES=50MB
SILO_MIRROR_QUOTA_PER_ACCOUNT=0
SILO_UNDO_WINDOW=10s
SILO_MAX_ATTACHMENT_BYTES=25MB
# IMAP keyword limit per folder (Dovecot maildir: 26; 0 = no limit, e.g. sdbox/mdbox). See docs/admin.
SILO_SYNC_KEYWORD_FOLDER_LIMIT=26

# silo-server tests only (not the instance, not compose): SILO_REQUIRE_DOCKER=true (testcontainers tests
# must run), SILO_BENCH_SEARCH=true with SILO_BENCH_MESSAGES (e.g. 1000000) and SILO_BENCH_EXPLAIN=true -
# p95 search benchmark (silo-server README).

# Phase 5: silo-server instance variables (docker-compose.dev.yml sets imap and fs).
# Authentication mode: imap = sign-in with mailbox credentials (dev stack),
# local = Silo's own users (`silo-server user add`, admin panel).
# SILO_AUTH_MODE=imap
# Blob store: fs = the SILO_BLOB_FS_DIR directory (default /data/blobs, volume `blobs`),
# s3 = an S3/MinIO bucket (must exist; silo-server README, section S3Store).
# SILO_BLOB_BACKEND=fs
# SILO_BLOB_S3_ENDPOINT=minio:9000
# SILO_BLOB_S3_BUCKET=silo
# SILO_BLOB_S3_ACCESS_KEY=
# SILO_BLOB_S3_SECRET_KEY=
# SILO_BLOB_S3_REGION=us-east-1
# SILO_BLOB_S3_PREFIX=
# SILO_BLOB_S3_USE_SSL=true
# SILO_BLOB_S3_PATH_STYLE=true

# Host ports of the backup test stack (docker-compose.backup-test.yml, scripts/e2e-backup-restore.sh).
# SILO_BT_PG_PORT=15432
# SILO_BT_SERVER_PORT=18080
# SILO_BT_IMAP_PORT=11143
# SILO_BT_SMTP_PORT=12525
# SILO_BT_SUBMISSION_PORT=11587

# --- Production: docker-compose.yml + one variant (README.md "Quick start: production", docs/admin/README.md) ---
# The base docker-compose.yml passes all SILO_* from .env to silo-server (env_file); the dev stack
# (docker-compose.dev.yml) does not read them. Empty SILO_SECRET_KEY / SILO_POSTGRES_PASSWORD
# stop the start-up - set your own values.
# Optional shortcut: the variant files, so that a plain `docker compose up -d` / `pull` / `logs` uses them
# (separator ":"; on Windows ";" - or set COMPOSE_PATH_SEPARATOR). One of:
# COMPOSE_FILE=docker-compose.yml:deploy/caddy/docker-compose.yml
# COMPOSE_FILE=docker-compose.yml:deploy/http/docker-compose.yml
# COMPOSE_FILE=docker-compose.yml:deploy/nginx/docker-compose.yml
#
# Variant caddy (HTTPS): the instance domain (a DNS record for this host; Caddy obtains an ACME
# certificate, localhost = internal certificate). Required by this variant only.
SILO_DOMAIN=poczta.example.com
# The address in the browser (Origin checks, the Secure cookie, OAuth2 return addresses).
# Variant caddy: defaults to https://$SILO_DOMAIN; change it only for another port/path.
# Variant http: required, e.g. http://192.168.1.10:8080 (or https://... behind your own TLS terminator).
# Variant nginx: required, https://<the Silo domain>.
# SILO_PUBLIC_URL=https://mail.example.com
# 32 random bytes: openssl rand -base64 32. Keep a copy SEPARATELY from the database backup (without it mailbox passwords are lost).
SILO_SECRET_KEY=
# Postgres password on the compose network (no characters that need URL encoding): openssl rand -hex 24.
SILO_POSTGRES_PASSWORD=
# Image versions of ghcr.io/silopost/* (upgrade: change them, then pull and up -d with the same -f files).
SILO_SERVER_TAG=0.9.0
SILO_WEB_TAG=0.8.0
# Other image repositories (e.g. your own registry when a ghcr.io package is not public).
# SILO_SERVER_IMAGE=ghcr.io/silopost/silo-server
# SILO_WEB_IMAGE=ghcr.io/silopost/silo-web
# Caddy host ports. Variant caddy: HTTP 80 and HTTPS 443 (+ UDP for HTTP/3).
# Variant http: SILO_HTTP_PORT only, default 8080 (127.0.0.1:8080 = loopback only).
# SILO_HTTP_PORT=80
# SILO_HTTPS_PORT=443
# The compose network subnet (variants caddy and http: Caddy connects to silo-server from it).
# SILO_NETWORK_SUBNET=172.29.250.0/24
# Trusted proxies (default SILO_NETWORK_SUBNET); add the address of a load balancer in front of Caddy.
# Variant nginx: required, the subnet of SILO_PROXY_NETWORK.
# SILO_TRUSTED_PROXIES=172.29.250.0/24
# Variant nginx: the existing Docker network of the nginx container (deploy/nginx/.env.example).
# SILO_PROXY_NETWORK=nginx_default
# Default server (mode imap: sign-in with mailbox credentials). docker-mailserver on the same host:
# the container name after attaching it to the compose network (docs/admin), otherwise the public host name.
SILO_AUTH_MODE=imap
SILO_DEFAULT_IMAP_HOST=mail.example.com
SILO_DEFAULT_IMAP_PORT=993
SILO_DEFAULT_IMAP_TLS=implicit
SILO_DEFAULT_SMTP_PORT=587
SILO_DEFAULT_SMTP_TLS=starttls
# SILO_DEFAULT_LOGIN_FORMAT=email
# SILO_ALLOW_CUSTOM_SERVERS=false
# SILO_CUSTOM_SERVER_ALLOWLIST=
# Hardening (silo-server README, "Hardening"); text makes fail2ban on Docker logs easier.
SILO_LOG_FORMAT=text
# SILO_RATE_LIMIT_API=600/m
# SILO_RATE_LIMIT_AUTH=20/m
# SILO_HSTS=true
# Account autoconfiguration (Thunderbird's ISPDB; off = disabled).
# SILO_AUTOCONFIG_ISPDB_URL=https://autoconfig.thunderbird.net/v1.1/
# OAuth2 (docs/admin/oauth.md): set the client ID and the secret together.
# SILO_OAUTH_GOOGLE_CLIENT_ID=
# SILO_OAUTH_GOOGLE_CLIENT_SECRET=
# SILO_OAUTH_MICROSOFT_CLIENT_ID=
# SILO_OAUTH_MICROSOFT_CLIENT_SECRET=
# SILO_OAUTH_MICROSOFT_TENANT=common
