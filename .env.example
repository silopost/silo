# Skopiuj do .env (plik .env jest ignorowany przez git; scripts/dev-up.sh robi to sam).
# Zmienne instancji silo-server dla dev sa wpisane w docker-compose.dev.yml.

# Porty hosta dla docker-compose.dev.yml (zmien, gdy domyslne sa zajete).
SILO_DEV_PG_PORT=5432
SILO_DEV_SERVER_PORT=8080
SILO_DEV_WEB_PORT=5173
SILO_DEV_IMAP_PORT=1143
SILO_DEV_SMTP_PORT=2525
SILO_DEV_SUBMISSION_PORT=1587

# Silnik synchronizacji IMAP i write-back (silo-server, plan 2.5); docker-compose.dev.yml
# przekazuje je do kontenera silo-server. Wartosci = domyslne.
SILO_SYNC_MAX_CONNECTIONS_PER_ACCOUNT=3
SILO_SYNC_INITIAL_CONCURRENCY=2
SILO_SYNC_POLL_INTERVAL=5m
SILO_SYNC_BACKFILL_RATE=5MB/s
SILO_MIRROR_MAX_MESSAGE_BYTES=50MB
SILO_MIRROR_QUOTA_PER_ACCOUNT=0
SILO_UNDO_WINDOW=10s
SILO_MAX_ATTACHMENT_BYTES=25MB
# Limit slow kluczowych IMAP na folder (Dovecot maildir: 26; 0 = bez limitu, np. sdbox/mdbox). Plan 3.7, docs/admin.
SILO_SYNC_KEYWORD_FOLDER_LIMIT=26

# Tylko testy silo-server (nie instancja, nie compose): SILO_REQUIRE_DOCKER=true (testy z testcontainers
# musza dzialac), SILO_BENCH_SEARCH=true z SILO_BENCH_MESSAGES (np. 1000000) i SILO_BENCH_EXPLAIN=true -
# benchmark wyszukiwania p95 (plan 3.12; README silo-server).

# Faza 5: zmienne instancji silo-server (docker-compose.dev.yml ma wpisane imap i fs).
# Tryb uwierzytelniania: imap = logowanie danymi skrzynki (stos dev),
# local = wlasni uzytkownicy Silo (`silo-server user add`, panel admina).
# SILO_AUTH_MODE=imap
# Magazyn blobow: fs = katalog SILO_BLOB_FS_DIR (domyslnie /data/blobs, wolumen `blobs`),
# s3 = bucket S3/MinIO (musi istniec; README silo-server, sekcja S3Store).
# SILO_BLOB_BACKEND=fs
# SILO_BLOB_S3_ENDPOINT=minio:9000
# SILO_BLOB_S3_BUCKET=silo
# SILO_BLOB_S3_ACCESS_KEY=
# SILO_BLOB_S3_SECRET_KEY=
# SILO_BLOB_S3_REGION=us-east-1
# SILO_BLOB_S3_PREFIX=
# SILO_BLOB_S3_USE_SSL=true
# SILO_BLOB_S3_PATH_STYLE=true

# Porty hosta stosu testu backupu (docker-compose.backup-test.yml, scripts/e2e-backup-restore.sh).
# SILO_BT_PG_PORT=15432
# SILO_BT_SERVER_PORT=18080
# SILO_BT_IMAP_PORT=11143
# SILO_BT_SMTP_PORT=12525
# SILO_BT_SUBMISSION_PORT=11587

# --- Produkcja: docker-compose.yml (docs/admin/README.md, "Instalacja produkcyjna") ---
# docker-compose.yml przekazuje wszystkie SILO_* z .env do silo-server (env_file); stos dev
# (docker-compose.dev.yml) ich nie czyta. Puste SILO_SECRET_KEY / SILO_POSTGRES_PASSWORD
# zatrzymuja start - wpisz wlasne wartosci.
# Domena instancji (rekord DNS na ten host; Caddy pobiera certyfikat ACME, localhost = certyfikat wewnetrzny).
SILO_DOMAIN=poczta.example.com
# Domyslnie https://$SILO_DOMAIN; zmien tylko przy innym porcie/sciezce.
# SILO_PUBLIC_URL=https://poczta.example.com
# 32 losowe bajty: openssl rand -base64 32. Trzymaj kopie OSOBNO od backupu bazy (bez niego hasla skrzynek przepadaja).
SILO_SECRET_KEY=
# Haslo Postgresa w sieci compose (bez znakow kodowanych w URL): openssl rand -hex 24.
SILO_POSTGRES_PASSWORD=
# Wersje obrazow ghcr.io/silopost/* (upgrade: zmien, potem docker compose pull && docker compose up -d).
SILO_SERVER_TAG=0.5.0
SILO_WEB_TAG=0.4.0
# Porty hosta Caddy i podsiec sieci compose (Caddy laczy sie z niej z silo-server).
# SILO_HTTP_PORT=80
# SILO_HTTPS_PORT=443
# SILO_NETWORK_SUBNET=172.29.250.0/24
# Zaufane proxy (domyslnie SILO_NETWORK_SUBNET); dopisz adres balancera przed Caddy.
# SILO_TRUSTED_PROXIES=172.29.250.0/24
# Serwer domyslny (tryb imap: logowanie danymi skrzynki). docker-mailserver na tym samym hoscie:
# nazwa kontenera po podlaczeniu do sieci compose (docs/admin), inaczej publiczna nazwa hosta.
SILO_AUTH_MODE=imap
SILO_DEFAULT_IMAP_HOST=mail.example.com
SILO_DEFAULT_IMAP_PORT=993
SILO_DEFAULT_IMAP_TLS=implicit
SILO_DEFAULT_SMTP_PORT=587
SILO_DEFAULT_SMTP_TLS=starttls
# SILO_DEFAULT_LOGIN_FORMAT=email
# SILO_ALLOW_CUSTOM_SERVERS=false
# SILO_CUSTOM_SERVER_ALLOWLIST=
# Hardening (README silo-server, "Hardening"); text ulatwia fail2ban z logow dockera.
SILO_LOG_FORMAT=text
# SILO_RATE_LIMIT_API=600/m
# SILO_RATE_LIMIT_AUTH=20/m
# SILO_HSTS=true
# Autokonfiguracja kont (ISPDB Thunderbirda; off = wylaczona).
# SILO_AUTOCONFIG_ISPDB_URL=https://autoconfig.thunderbird.net/v1.1/
# OAuth2 (docs/admin/oauth.md): identyfikator i sekret podaje sie razem.
# SILO_OAUTH_GOOGLE_CLIENT_ID=
# SILO_OAUTH_GOOGLE_CLIENT_SECRET=
# SILO_OAUTH_MICROSOFT_CLIENT_ID=
# SILO_OAUTH_MICROSOFT_CLIENT_SECRET=
# SILO_OAUTH_MICROSOFT_TENANT=common
