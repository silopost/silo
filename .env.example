# Skopiuj do .env (plik .env jest ignorowany przez git).
# Faza 0: docker-compose.dev.yml nie wymaga zadnych zmiennych - wartosci dev sa wpisane w pliku.
# Zmienne instancji (SILO_SECRET_KEY, SILO_PUBLIC_URL, SILO_AUTH_MODE, SILO_DEFAULT_IMAP_*,
# SILO_DEFAULT_SMTP_*, SILO_DOMAIN) - uzupelniane w Fazie 1.

# Porty hosta dla docker-compose.dev.yml (zmien, gdy domyslne sa zajete).
SILO_DEV_PG_PORT=5432
SILO_DEV_SERVER_PORT=8080
SILO_DEV_WEB_PORT=5173
