# Skopiuj do .env (plik .env jest ignorowany przez git; scripts/dev-up.sh robi to sam).
# Zmienne instancji silo-server dla dev sa wpisane w docker-compose.dev.yml.

# Porty hosta dla docker-compose.dev.yml (zmien, gdy domyslne sa zajete).
SILO_DEV_PG_PORT=5432
SILO_DEV_SERVER_PORT=8080
SILO_DEV_WEB_PORT=5173
SILO_DEV_IMAP_PORT=1143
SILO_DEV_SMTP_PORT=2525
SILO_DEV_SUBMISSION_PORT=1587
