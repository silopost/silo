# Silo behind an existing nginx: the base docker-compose.yml + deploy/nginx/docker-compose.yml (README.md here).
# Portainer: Stacks -> Add stack -> Environment variables -> "Load variables from .env file" with this file
# filled in. CLI: copy it to .env in the repository root (compose reads .env from there).
# SILO_PROXY_NETWORK / SILO_TRUSTED_PROXIES below are for an nginx deployed as a Portainer stack "nginx"
# (container nginx-app); check them on your host. Empty SILO_SECRET_KEY / SILO_POSTGRES_PASSWORD stop the deployment.

# The address in the browser (Origin checks, the Secure cookie, OAuth2 return addresses).
# A DNS record for it must point at the nginx host, and nginx needs a certificate for it (README.md).
SILO_PUBLIC_URL=https://silo.example.com
# 32 random bytes: openssl rand -base64 32. Keep a copy SEPARATELY from the database backup.
SILO_SECRET_KEY=
# Postgres password on the stack network (no characters that need URL encoding): openssl rand -hex 24.
SILO_POSTGRES_PASSWORD=
# Image versions of ghcr.io/silopost/* (defaults: the base docker-compose.yml).
SILO_SERVER_TAG=0.7.0
SILO_WEB_TAG=0.6.0
# Other image repositories (e.g. your own registry when a ghcr.io package is not public).
# SILO_SERVER_IMAGE=ghcr.io/silopost/silo-server
# SILO_WEB_IMAGE=ghcr.io/silopost/silo-web

# The existing Docker network of the nginx container; silo-server and silo-web join it.
#   docker inspect -f '{{json .NetworkSettings.Networks}}' nginx-app
# Portainer stack "nginx" -> network nginx_default.
SILO_PROXY_NETWORK=nginx_default
# The subnet of that network: nginx's X-Forwarded-For is honored only from it.
#   docker network inspect -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}' nginx_default
# Every container on that network is trusted as a proxy - keep only the proxy (and its certbot) on it.
SILO_TRUSTED_PROXIES=172.20.0.0/16

# Default server (mode imap: sign-in with mailbox credentials). The public host name of the mail
# server: ports 993/587 are published on the host and its certificate is issued for this name.
SILO_AUTH_MODE=imap
SILO_DEFAULT_IMAP_HOST=mail.example.com
SILO_DEFAULT_IMAP_PORT=993
SILO_DEFAULT_IMAP_TLS=implicit
# Defaults to SILO_DEFAULT_IMAP_HOST.
# SILO_DEFAULT_SMTP_HOST=
SILO_DEFAULT_SMTP_PORT=587
SILO_DEFAULT_SMTP_TLS=starttls
SILO_LOG_FORMAT=text

# Further SILO_* (passed through stack.env in Portainer; the main .env.example lists them), e.g.:
# SILO_DEFAULT_LOGIN_FORMAT=email
# SILO_MAX_ATTACHMENT_BYTES=25MB   # raise client_max_body_size in silo.conf together with it
# SILO_RATE_LIMIT_AUTH=20/m
# SILO_OAUTH_GOOGLE_CLIENT_ID=
# SILO_OAUTH_GOOGLE_CLIENT_SECRET=
# The stack's own network (postgres; fixed so that it does not move between deployments).
# SILO_NETWORK_SUBNET=172.29.250.0/24
# CLI only: the file with the further SILO_* (default .env; Portainer's stack.env is read as well),
# and the variant files, so that a plain `docker compose up -d` works (README.md here).
# SILO_ENV_FILE=.env
# COMPOSE_FILE=docker-compose.yml:deploy/nginx/docker-compose.yml
